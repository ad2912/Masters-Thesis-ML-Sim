import numpy as np
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt
import os

GEN_NPZ, G4_NPZ, CC3_NPZ = "gen_master.npz", "g4_master.npz", "cc3_master.npz"
PLOT_DIR = os.path.expanduser("~/thesis-ml-sim/plots/energy_distributions_100k")
os.makedirs(PLOT_DIR, exist_ok=True)

E_THRESH = 10.0
BINS_E = np.arange(0, 132, 2)

# Colors & Style
C_GEN, C_G4, C_CC3, C_CC_FS, C_FRAC = "#333333", "#2166ac", "#d6604d", "#f4a582", "#d6604d"
plt.rcParams.update({"font.family": "serif", "font.size": 12, "figure.dpi": 150})

def add_fraction_panel(ax, total_e, fs_e, bins):
    h_tot, _ = np.histogram(total_e, bins=bins)
    h_fs,  _ = np.histogram(fs_e,  bins=bins)
    valid = h_tot > 0
    frac = np.where(valid, h_fs / h_tot, 0.0)
    frac_err = np.where(valid, np.sqrt(frac * (1 - frac) / np.where(valid, h_tot, 1)), 0.0)
    ax.errorbar(0.5*(bins[:-1]+bins[1:])[valid], frac[valid], yerr=frac_err[valid], 
                fmt="o", color=C_FRAC, markersize=4, label="Fast-sim fraction")
    ax.axhline(1.0, color="gray", lw=0.8, ls="--")
    ax.set_ylim(-0.05, 1.15)
    ax.set_ylabel("Fraction")

def make_plot(title, filename, gen_e=None, g4_e=None, cc3_total_e=None, cc3_fs_e=None, show_fraction=False):
    fig, (ax, ax_f) = plt.subplots(2,1, figsize=(10,8), gridspec_kw={'height_ratios':[2,1]}, sharex=True) if show_fraction else (plt.subplots(figsize=(10,6)) + (None,))
    if gen_e is not None: ax.hist(gen_e, bins=BINS_E, histtype="step", color=C_GEN, lw=2, label=f"GEN (N={len(gen_e)})")
    if g4_e is not None: ax.hist(g4_e, bins=BINS_E, histtype="step", color=C_G4, lw=2, label=f"G4 (N={len(g4_e)})")
    if cc3_total_e is not None: ax.hist(cc3_total_e, bins=BINS_E, histtype="step", color=C_CC3, lw=2, ls="--", label=f"CC3 Total (N={len(cc3_total_e)})")
    if cc3_fs_e is not None: ax.hist(cc3_fs_e, bins=BINS_E, histtype="stepfilled", color=C_CC_FS, alpha=0.5, label=f"CC3 FS (N={len(cc3_fs_e)})")
    ax.set_yscale("log")
    ax.legend()
    ax.set_title(title)
    if show_fraction: add_fraction_panel(ax_f, cc3_total_e, cc3_fs_e, BINS_E)
    plt.savefig(f"{PLOT_DIR}/{filename}", bbox_inches="tight")
    plt.close()

gen, g4, cc3 = np.load(GEN_NPZ), np.load(G4_NPZ), np.load(CC3_NPZ)
m_sig = (cc3['stat'] == 1) & (cc3['cat'] == 0)
make_plot("Energy — π⁰ daughters", "energy_pi0.png", gen_e=gen['e'][(gen['stat']==1)&(gen['cat']==0)], 
          cc3_total_e=cc3['e'][m_sig], cc3_fs_e=cc3['e'][m_sig & cc3['fs']], show_fraction=True)
