PLOT_DIR  = os.path.expanduser("~/thesis-ml-sim/plots/photon-analysis")
os.makedirs(PLOT_DIR, exist_ok=True)

PHOTON_PDG    = 22
ML_THRESHOLD  = 10
ML_ENERGY_GEV = 10.0

ECAL_RELATIONS = [
    "EcalBarrelRelationsSimRec",
    "EcalEndcapsRelationsSimRec",
    "EcalEndcapRingRelationsSimRec",
]

# ─────────────────────────────────────────────────────────────────────────────
# COLOURS
# ─────────────────────────────────────────────────────────────────────────────
C_G4    = "#2166ac"   # blue   — full Geant4
C_CC    = "#d6604d"   # red    — CaloClouds total
C_ML    = "#f4a582"   # orange — ML-classified
C_CC_G4 = "#4dac26"   # green  — G4-type inside CC

# ─────────────────────────────────────────────────────────────────────────────
# STYLE
# ─────────────────────────────────────────────────────────────────────────────
plt.rcParams.update({
    "font.family"      : "serif",
    "font.size"        : 12,
    "axes.titlesize"   : 13,
    "axes.labelsize"   : 12,
    "legend.fontsize"  : 10,
    "axes.spines.top"  : False,
    "axes.spines.right": False,
    "figure.dpi"       : 150,
})

def sim_label(ax):
    ax.text(0.01, 1.01, "ILD simulation (preliminary)",
            transform=ax.transAxes, fontsize=9, color="gray", va="bottom")

def save(fig, name):
    path = f"{PLOT_DIR}/{name}"
    fig.savefig(path, bbox_inches="tight")
    plt.close(fig)
    print(f"  ✓  {name}")

def to_angles(px, py, pz):
    p = np.sqrt(px**2 + py**2 + pz**2)
    if p == 0:
        return 0.0, 0.0
    theta = np.degrees(np.arccos(np.clip(pz / p, -1, 1)))
    phi   = np.degrees(np.arctan2(py, px))
    return theta, phi

# ─────────────────────────────────────────────────────────────────────────────
# LOADERS
# ─────────────────────────────────────────────────────────────────────────────
def load_g4_reco(path, label):
    reader = root_io.Reader(path)
    e_list, th_list, ph_list = [], [], []
    for event in reader.get("events"):
        for pfo in event.get("PandoraPFOs"):
            if pfo.getPDG() != PHOTON_PDG:
                continue
            e_list.append(pfo.getEnergy())
            mom = pfo.getMomentum()
            th, ph = to_angles(mom.x, mom.y, mom.z)
            th_list.append(th)
            ph_list.append(ph)
    print(f"  {label}: {len(e_list)} reco photons")
    return np.array(e_list), np.array(th_list), np.array(ph_list)


def load_cc_reco(path, label):
    reader = root_io.Reader(path)
    ml_e,  ml_th,  ml_ph  = [], [], []
    g4_e,  g4_th,  g4_ph  = [], [], []
    n_unmatched = 0

    for event in reader.get("events"):
        hit_lookup = {}
        for rel_name in ECAL_RELATIONS:
            try:
                for rel in event.get(rel_name):
                    hit_lookup[rel.getFrom().getObjectID().index] = rel.getTo()
            except Exception:
                pass

        for pfo in event.get("PandoraPFOs"):
            if pfo.getPDG() != PHOTON_PDG:
                continue

            ml_count = 0
            for cluster in pfo.getClusters():
                for rec_hit in cluster.getHits():
                    sim_hit = hit_lookup.get(rec_hit.getObjectID().index)
                    if sim_hit is None:
                        n_unmatched += 1
                        continue
                    for contrib in sim_hit.getContributions():
                        if contrib.getStepLength() == 0:
                            ml_count += 1
                            break

            e = pfo.getEnergy()
            mom = pfo.getMomentum()
            th, ph = to_angles(mom.x, mom.y, mom.z)

            if ml_count > ML_THRESHOLD:
                ml_e.append(e);  ml_th.append(th);  ml_ph.append(ph)
            else:
                g4_e.append(e);  g4_th.append(th);  g4_ph.append(ph)

    total = len(ml_e) + len(g4_e)
    print(f"  {label}: {total} reco photons total")
    print(f"    → ML-classified : {len(ml_e)}  ({100*len(ml_e)/max(total,1):.1f}%)")
    print(f"    → G4-classified : {len(g4_e)}  ({100*len(g4_e)/max(total,1):.1f}%)")
    if n_unmatched > 0:
        print(f"    ⚠ Unmatched hits : {n_unmatched}")

    return (np.array(ml_e),  np.array(ml_th),  np.array(ml_ph),
            np.array(g4_e),  np.array(g4_th),  np.array(g4_ph))


# ─────────────────────────────────────────────────────────────────────────────
# LOAD DATA
# ─────────────────────────────────────────────────────────────────────────────
print("\n" + "="*60)
print("  Loading Geant4 reco (3 parts)")
print("="*60)
g4_e_1, g4_th_1, g4_ph_1 = load_g4_reco(REC_G4_P1, "G4 part1 (775 events)")
g4_e_2, g4_th_2, g4_ph_2 = load_g4_reco(REC_G4_P2, "G4 part2  (28 events)")
g4_e_3, g4_th_3, g4_ph_3 = load_g4_reco(REC_G4_P3, "G4 part3 (195 events)")

g4_e  = np.concatenate([g4_e_1,  g4_e_2,  g4_e_3])
g4_th = np.concatenate([g4_th_1, g4_th_2, g4_th_3])
g4_ph = np.concatenate([g4_ph_1, g4_ph_2, g4_ph_3])
