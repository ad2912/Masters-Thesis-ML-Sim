# ── PLOT 1: Combined energy spectrum
fig, ax = plt.subplots(figsize=(9, 6))
ax.hist(g4_e, bins=bins_e, histtype="step", color=C_G4,
        linewidth=2, label=f"Full Geant4  (N={len(g4_e)})")
