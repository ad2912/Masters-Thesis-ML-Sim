print("  Loading CaloClouds reco + ML classification")
print("="*60)
ml_e, ml_th, ml_ph, ccg4_e, ccg4_th, ccg4_ph = load_cc_reco(REC_CC, "CaloClouds")
cc_e  = np.concatenate([ml_e,  ccg4_e])
cc_th = np.concatenate([ml_th, ccg4_th])
cc_ph = np.concatenate([ml_ph, ccg4_ph])

print(f"\n  {'Category':<38}  {'N':>5}  {'Mean E':>8}")
print(f"  {'-'*38}  {'-'*5}  {'-'*8}")
print(f"  {'Geant4 reco (998 events)':<38}  "
      f"{len(g4_e):>5}  {np.mean(g4_e):>7.2f} GeV")
print(f"  {'CaloClouds reco (1000 events)':<38}  "
      f"{len(cc_e):>5}  {np.mean(cc_e):>7.2f} GeV")
print(f"  {'  └─ ML-classified':<38}  "
      f"{len(ml_e):>5}  {np.mean(ml_e) if len(ml_e)>0 else 0:>7.2f} GeV")
print(f"  {'  └─ G4-classified (in CC)':<38}  "
      f"{len(ccg4_e):>5}  "
      f"{np.mean(ccg4_e) if len(ccg4_e)>0 else 0:>7.2f} GeV")

# ─────────────────────────────────────────────────────────────────────────────
# PLOTS
